#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# Docker starts the first time it's used (its socket), not at every boot:
	# no daemon taking memory on a computer that isn't running containers.
	# Docker needs sudo (its group is as good as root, so nobody is added to
	# it by default); Podman runs as the user without it.
	systemctl disable docker.service >/dev/null 2>&1 || true
	systemctl enable docker.socket >/dev/null 2>&1 || true
fi
exit 0
