#!/bin/sh
set -e

# CybroidOS was CIT-OS until 0.1.2. The old citos-* package is now empty, and
# dpkg keeps its settings files on disk as "obsolete" (a sources list, sign-in
# and GRUB settings under the old names, read beside the new ones). Remove
# those the new package doesn't own; an edited one is kept as .dpkg-old.
drop_citos_conffiles() {
	old="$1" new="$2"
	dpkg-query -W -f='${Conffiles}\n' "${old}" 2>/dev/null | awk '$3 == "obsolete" { print $1, $2 }' |
	while read -r f sum; do
		[ -e "${f}" ] || continue
		dpkg-query -W -f='${Conffiles}\n' "${new}" 2>/dev/null | awk '{ print $1 }' | grep -qxF "${f}" && continue
		if [ "$(md5sum < "${f}" | cut -d' ' -f1)" = "${sum}" ]; then
			rm -f "${f}"
		else
			mv -f "${f}" "${f}.dpkg-old"
		fi
	done
}
if [ "$1" = "configure" ]; then
	drop_citos_conffiles citos-desktop cybroid-desktop
fi
chmod 0755 /usr/libexec/cybroid/desktop-look
# CybroidOS's xsettings.xml (theme, icons, fonts) in place of xfce4-settings'
# (diverted aside in preinst). Copied, not shipped there, so an upgrade
# never stops to ask about it.
install -m 0644 /usr/share/cybroid/desktop/xsettings.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
# xrdp reads its TLS key from ssl-cert's group.
if getent group ssl-cert >/dev/null && id xrdp >/dev/null 2>&1; then
	adduser --quiet xrdp ssl-cert || true
fi
# Start graphical, on the sign-in screen.
if [ -d /run/systemd/system ] || [ -d /etc/systemd/system ]; then
	systemctl set-default graphical.target >/dev/null 2>&1 || true
fi
exit 0
