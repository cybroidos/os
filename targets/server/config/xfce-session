#!/bin/sh
# Cybroid OS server/pods Xfce launcher.
#
# Installed as /etc/cybroidos/xfce-session and started by
# cybroidos-xfce-session.service. RDP is primary (xrdp + sesman); noVNC is the
# browser fallback: a dedicated Xvfb :99 Xfce session is exported by x11vnc on
# localhost and bridged to HTTP/WebSocket on port 6080 by websockify.
set -eu

# shellcheck disable=SC1091  # files are installed into the image
. /etc/cybroidos/server.conf
if [ -r /etc/cybroidos/novnc.conf ]; then
	# shellcheck disable=SC1091  # installed into the image
	. /etc/cybroidos/novnc.conf
fi
if [ -r /etc/cybroidos/xfce-media.conf ]; then
	# shellcheck disable=SC1091  # rendered from brand.toml at build time
	. /etc/cybroidos/xfce-media.conf
fi

: "${ADMIN_USER:=cybroid}"
: "${RDP_ENABLE:=1}"
: "${NOVNC_ENABLE:=1}"
: "${RDP_PORT:=3389}"
: "${NOVNC_PORT:=6080}"
: "${VNC_PORT:=5900}"
: "${SESSION_DISPLAY:=:99}"
: "${SESSION_GEOMETRY:=1280x800x24}"
: "${NOVNC_WEB_ROOT:=/usr/share/novnc}"
: "${NOVNC_BIND:=0.0.0.0}"
: "${VNC_HOST:=127.0.0.1}"
: "${X11VNC_EXTRA_ARGS:=}"

pids=""
cleanup() {
	for pid in ${pids}; do
		kill "${pid}" >/dev/null 2>&1 || true
	done
}
trap cleanup EXIT HUP INT TERM

if [ "${RDP_ENABLE}" = 1 ]; then
	echo "cybroidos-xfce-session: starting xrdp on port ${RDP_PORT}"
	if command -v systemctl >/dev/null 2>&1; then
		systemctl start xrdp.service xrdp-sesman.service || \
			echo "warning: could not start xrdp via systemd" >&2
	else
		echo "warning: systemctl unavailable; xrdp must be started separately" >&2
	fi
fi

if [ "${NOVNC_ENABLE}" != 1 ]; then
	# RDP only: keep the unit alive without consuming a display.
	while :; do sleep 3600; done
fi

for tool in /usr/bin/Xvfb "${XFCE_SESSION}" /usr/bin/x11vnc /usr/bin/websockify; do
	[ -x "${tool}" ] || { echo "error: missing ${tool}" >&2; exit 1; }
done

runtime_dir="/run/cybroidos-session"
mkdir -p "${runtime_dir}"
chown "${ADMIN_USER}:${ADMIN_USER}" "${runtime_dir}"
chmod 0700 "${runtime_dir}"

echo "cybroidos-xfce-session: starting Xfce on ${SESSION_DISPLAY}"
runuser -u "${ADMIN_USER}" -- env \
	DISPLAY="${SESSION_DISPLAY}" XDG_RUNTIME_DIR="${runtime_dir}" \
	XDG_CONFIG_HOME="/home/${ADMIN_USER}/.config" \
	/usr/bin/Xvfb "${SESSION_DISPLAY}" -screen 0 "${SESSION_GEOMETRY}" -nolisten tcp &
xvfb_pid=$!
pids="${pids} ${xvfb_pid}"
sleep 1

runuser -u "${ADMIN_USER}" -- env \
	DISPLAY="${SESSION_DISPLAY}" XDG_RUNTIME_DIR="${runtime_dir}" \
	XDG_CONFIG_HOME="/home/${ADMIN_USER}/.config" \
	"${XFCE_SESSION}" &
xfce_pid=$!
pids="${pids} ${xfce_pid}"

echo "cybroidos-xfce-session: noVNC fallback on port ${NOVNC_PORT}"
# shellcheck disable=SC2086  # X11VNC_EXTRA_ARGS is a build-time option string
runuser -u "${ADMIN_USER}" -- env DISPLAY="${SESSION_DISPLAY}" \
	/usr/bin/x11vnc -display "${SESSION_DISPLAY}" -localhost -nopw \
	-forever -shared -rfbport "${VNC_PORT}" ${X11VNC_EXTRA_ARGS} &
vnc_pid=$!
pids="${pids} ${vnc_pid}"

runuser -u "${ADMIN_USER}" -- /usr/bin/websockify \
	--web="${NOVNC_WEB_ROOT}" "${NOVNC_BIND}:${NOVNC_PORT}" \
	"${VNC_HOST}:${VNC_PORT}" &
novnc_pid=$!
pids="${pids} ${novnc_pid}"

wait
