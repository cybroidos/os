#!/bin/sh
set -e
# Puts Debian's own source entries back (see postinst).
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	keep=/etc/apt/cybroid-replaced
	if [ -f "$keep/debian.sources" ] && [ ! -e /etc/apt/sources.list.d/debian.sources ]; then
		mv "$keep/debian.sources" /etc/apt/sources.list.d/debian.sources
	fi
	rmdir "$keep" 2>/dev/null || true
	[ -f /etc/apt/sources.list ] && sed -i 's@^#cybroid-off# @@' /etc/apt/sources.list
fi
exit 0
