#!/bin/sh
set -e

# Brand system identity files owned by base-files by diverting them aside, so
# our versions in /etc/issue, /etc/motd and /usr/lib/os-release take effect.
# Diverting avoids Conflicts/Replaces on base-files (which is Essential) and
# avoids dpkg conffile prompts.
if [ "$1" = "install" ]; then
	for f in /usr/lib/os-release /etc/issue /etc/motd; do
		dpkg-divert --package cybroidos-base --add --rename \
			--divert "${f}.base-files" "$f"
	done
fi

#DEBHELPER#

exit 0
