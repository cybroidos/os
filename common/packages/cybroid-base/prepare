#!/bin/sh
# Stage cybroid-base: os-release, banners and logo SVGs, rendered from
# common/branding (target "base"). /etc/issue and /etc/motd belong to
# base-files, so they ship under /usr/share/cybroid and postinst copies them.
set -eu
root="$1"
repo="$2"
python3 "${repo}/tools/render-brand.py" --target base --out "${root}" >/dev/null
mv "${root}/etc/issue" "${root}/usr/share/cybroid/issue"
mv "${root}/etc/motd" "${root}/usr/share/cybroid/motd"
rmdir "${root}/etc" 2>/dev/null || true
