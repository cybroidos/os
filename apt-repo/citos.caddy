# CIT-OS's package sources at citos.cybroid.com (on the production server,
# /etc/caddy/conf.d/citos.caddy). Debian's archive under CIT-OS's name: apt
# checks Debian's signatures itself, so passing it through changes nothing
# but the address. The package citos-sources points machines here.
#   /debian/...           deb.debian.org/debian
#   /debian-security/...  deb.debian.org/debian-security
# The DNS record goes straight to the server (not through Cloudflare's proxy).
citos.cybroid.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	@debian path /debian/* /debian-security/*
	handle @debian {
		reverse_proxy https://deb.debian.org {
			header_up Host deb.debian.org
			header_down -Server
		}
	}
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "CIT-OS package sources (Debian 13 trixie). See https://cybroid.com" 200
	}
	log {
		output discard
	}
}
