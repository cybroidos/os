#!/bin/sh
set -e

theme=citos
conf=/etc/plymouth/plymouthd.conf

if [ "$1" = "configure" ]; then
	if command -v plymouth-set-default-theme >/dev/null; then
		plymouth-set-default-theme "$theme" || true
	fi
	# Check it took: an image once booted to the text fallback because the
	# theme was never written to plymouthd.conf.
	if ! grep -q "^Theme=$theme\$" "$conf" 2>/dev/null; then
		mkdir -p /etc/plymouth
		grep -q '^\[Daemon\]' "$conf" 2>/dev/null || printf '[Daemon]\n' >> "$conf"
		sed -i -e '/^Theme=/d' -e "s/^\[Daemon\]\$/[Daemon]\nTheme=$theme/" "$conf"
	fi
	if command -v update-initramfs >/dev/null; then
		update-initramfs -u -k all || true
	fi
fi

exit 0
