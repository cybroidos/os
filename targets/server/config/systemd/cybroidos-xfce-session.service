[Unit]
Description=Cybroid OS Xfce 4.20 remote session (RDP primary, noVNC fallback)
Documentation=https://github.com/cybroidtech/os
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/etc/cybroidos/xfce-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
