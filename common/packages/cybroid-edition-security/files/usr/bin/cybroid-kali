#!/bin/sh
# cybroid-kali (CybroidOS Security): Kali Linux's tools without leaving
# CybroidOS. The first run makes a container named "kali" from Kali's own
# image with its top ten tools, Burp Suite and Metasploit among them
# (Distrobox on Docker); every run opens a shell in it. Your home folder is
# shared with it, so files from either side are in the same place.
#   cybroid-kali            open a Kali shell (made the first time)
#   cybroid-kali --remove   delete the container
set -eu
name=kali
image=docker.io/kalilinux/kali-rolling:latest
export DBX_CONTAINER_MANAGER=docker
exists() { docker container inspect "${name}" >/dev/null 2>&1; }
if [ "${1:-}" = --remove ]; then
	exists && distrobox rm --force "${name}"
	exit 0
fi
if ! exists; then
	echo "Setting up Kali's tools (once; a few GB to download)…"
	distrobox create --yes --name "${name}" --image "${image}" --additional-packages "kali-tools-top10"
fi
exec distrobox enter "${name}"
