# CIT-OS Horizon dock (citos-plasma): frosted blue glass, round corners.
[PlankTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=255;;255;;255;;34
FillStartColor=38;;58;;120;;210
FillEndColor=26;;40;;88;;220
InnerStrokeColor=255;;255;;255;;14

[PlankDockTheme]
HorizPadding=3
TopPadding=2.5
BottomPadding=2.5
ItemPadding=3.5
IndicatorSize=4
IconShadowSize=1
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=28;;203;;255;;255
