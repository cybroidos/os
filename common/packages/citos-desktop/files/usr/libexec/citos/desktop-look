#!/bin/sh
# Gives each Xfce session the CIT-OS look until the person chooses their own:
# the wallpaper on every screen still showing Xfce's default (the screen's
# name differs between the console and Remote Desktop, so this runs at
# every sign-in), and, once per person, the dark theme and icons.
WALL=/usr/share/backgrounds/citos/citos-1920x1080.png
[ -f "$WALL" ] || exit 0
command -v xfconf-query >/dev/null || exit 0
sleep 4 # xfdesktop makes its properties as it starts
for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'); do
	cur=$(xfconf-query -c xfce4-desktop -p "$p" 2>/dev/null)
	case "$cur" in "" | */backgrounds/xfce/*) xfconf-query -c xfce4-desktop -p "$p" -s "$WALL" ;; esac
done
mark="${XDG_CONFIG_HOME:-$HOME/.config}/citos/look-set"
if [ ! -f "$mark" ]; then
	xfconf-query -c xsettings -p /Net/ThemeName -s Greybird-dark 2>/dev/null
	xfconf-query -c xsettings -p /Net/IconThemeName -s elementary-xfce-dark 2>/dev/null
	xfconf-query -c xfwm4 -p /general/theme -s Greybird-dark 2>/dev/null
	mkdir -p "$(dirname "$mark")" && : > "$mark"
fi
