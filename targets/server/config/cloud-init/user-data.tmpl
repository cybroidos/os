#cloud-config
# Cybroid OS server/pods cloud-init profile (NoCloud seed generated by
# targets/server/build.sh). The SSH key is injected from PUBKEY_FILE; no key is
# stored in this repository. No password login is created anywhere.
hostname: __CYBROIDOS_HOSTNAME__
preserve_hostname: false
manage_etc_hosts: true

users:
  - name: cybroid
    gecos: Cybroid administrator
    groups: [sudo, adm]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __CYBROIDOS_SSH_PUBLIC_KEY__

ssh_pwauth: false
disable_root: true

package_update: false
runcmd:
  - [ /usr/bin/cybroidos-first-boot ]
  - [ systemctl, restart, ssh.service ]
