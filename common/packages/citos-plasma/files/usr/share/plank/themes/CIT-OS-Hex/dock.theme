# CIT-OS Hex dock (citos-plasma): a graphite strip with a hairline edge and
# crisp corners, amber marks under running apps (the HUD design).
[PlankTheme]
TopRoundness=6
BottomRoundness=6
LineWidth=1
OuterStrokeColor=51;;66;;74;;255
FillStartColor=15;;21;;25;;235
FillEndColor=10;;14;;17;;235
InnerStrokeColor=255;;255;;255;;14

[PlankDockTheme]
HorizPadding=3
TopPadding=2.5
BottomPadding=2.5
ItemPadding=3.5
IndicatorSize=4
IconShadowSize=2.5
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=240;;166;;60;;255
