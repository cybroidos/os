#!/bin/sh
# Cybroid OS desktop one-time first-boot hygiene.
#
# Independent of the Raspberry Pi kiosk script: this one runs on installed
# desktop systems (and in live sessions) to undo image cloning artefacts and to
# force the first interactive user to choose a real password. No secrets are
# baked into the image.
set -eu

flag=/etc/cybroidos/first-boot-done
[ -e "${flag}" ] && exit 0

# Unique machine identity (cloned ISO installs must not share a machine-id).
if [ -r /proc/sys/kernel/random/uuid ]; then
	cat /proc/sys/kernel/random/uuid > /etc/machine-id
else
	rm -f /etc/machine-id
fi
rm -f /var/lib/dbus/machine-id
ln -sf /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true

# Unique SSH host keys, if OpenSSH is present.
rm -f /etc/ssh/ssh_host_*
if command -v ssh-keygen >/dev/null 2>&1; then
	ssh-keygen -A >/dev/null 2>&1 || true
fi

# Force a password change for whichever account was created at install time.
if command -v chage >/dev/null 2>&1; then
	for user_name in cybroid user; do
		if id "${user_name}" >/dev/null 2>&1; then
			chage -d 0 "${user_name}" >/dev/null 2>&1 || true
		fi
	done
fi

mkdir -p /etc/cybroidos
date -u +"%Y-%m-%dT%H:%M:%SZ" > "${flag}"
systemctl disable cybroidos-first-boot.service >/dev/null 2>&1 || true
