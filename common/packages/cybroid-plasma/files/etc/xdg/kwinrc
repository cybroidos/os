# CybroidOS window manager defaults (cybroid-plasma).
# The CybroidOS decoration (tools/aurorae-theme.py): round buttons on the left
# (close, minimise, zoom), the title centred.
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__CybroidOS
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false

[Plugins]
# No blur: surfaces are solid (CybroidOS reads better without glass), and
# blur drew square, noisy blocks at the rounded corners of popups.
blurEnabled=false
contrastEnabled=false
slidingpopupsEnabled=true
# Windows grow in as they open and shrink away as they close (scale), and
# minimise into the dock like macOS's genie (magic lamp).
scaleEnabled=true
fadeEnabled=false
magiclampEnabled=true
squashEnabled=false
kwin4_effect_shapecornersEnabled=true

# Rounded windows (cybroid-kwin-effects: KDE Rounded Corners).
[Round-Corners]
Size=18
InactiveCornerRadius=18
UseSquircleShape=true
OutlineThickness=1
InactiveOutlineThickness=1
ActiveOutlineAlpha=60
InactiveOutlineAlpha=40

# The Meta key opens the app grid (the dock's first button).
[ModifierOnlyShortcuts]
Meta=org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu

[Windows]
Placement=Centered

# Night Light (Control Centre's tile turns it on): warmer colours from
# sunset to sunrise in Kampala, fading in over half an hour.
[NightColor]
Active=false
Mode=Location
LatitudeFixed=0.3476
LongitudeFixed=32.5825
NightTemperature=4200

# No hot corners: Plasma opens Overview when the pointer touches the top-left
# corner, which is where Launchpad's button is, so reaching for it (or any
# small movement there) threw the desktop into Overview. Overview stays on
# Meta+W, and anyone can set corners again in Settings → Screen Edges.
[Effect-overview]
BorderActivate=9

[Effect-windowview]
BorderActivateAll=9

[ElectricBorders]
TopLeft=None
Top=None
TopRight=None
Right=None
BottomRight=None
Bottom=None
BottomLeft=None
Left=None

[TouchEdges]
Top=None
Bottom=None
Left=None
Right=None
