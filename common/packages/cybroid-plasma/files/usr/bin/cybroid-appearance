#!/bin/sh
# cybroid-appearance dark|light|hex|horizon|toggle|status: the CybroidOS design
# and appearance, applied live through Plasma's own tools, as Control
# Centre's Appearance and Design tiles do. Two designs, each Dark or Light:
#
#   dark, light   Dark or Light, in the design in use
#   horizon, hex  Horizon (the clean design) or Hex (the HUD: a dial and live
#                 readouts), in the appearance in use
#   horizon-dark, horizon-light, hex-dark, hex-light   both at once
#   toggle        Dark <-> Light, in the design in use
#   refresh [startup]  only the wallpaper and the desktop widgets' places, for the
#                 screens as they are now (run by cybroid-screens when a
#                 monitor is plugged in or a resolution changes)
#   status        prints dark, light, hex or hex-light
#
# Each sets: colours, the Plasma style (top bar, popups), icons, window title
# bars and corners, app controls (Kvantum: rounded for Horizon, cut corners for Hex), the
# dock, the desktop widgets' look and, where they are CybroidOS's own, the
# wallpaper and lock screen. GTK apps and Firefox follow the colour scheme
# through Plasma's GTK settings.
#
# Not plasma-apply-lookandfeel: it writes the theme as defaults
# (~/.config/kdedefaults), which the running shell and KWin don't reload.
set -eu
# Changing design restarts the desktop shell, and Control Centre runs this
# from inside it: stopping the shell killed this script half way (Qt kills
# the processes it started), before it started the shell again: a black
# screen and no dock. So the work runs as a user service of its own, which
# the shell never owned; --wait keeps it in step for whoever called it.
if [ "${1:-status}" != status ] && [ -z "${CYBROID_APPEARANCE_SERVICE:-}" ] && command -v systemd-run >/dev/null; then
	exec systemd-run --user --wait --quiet --collect --unit="cybroid-appearance-$$" \
		--setenv=CYBROID_APPEARANCE_SERVICE=1 --setenv=DISPLAY --setenv=XAUTHORITY --setenv=PATH \
		--setenv=XDG_CURRENT_DESKTOP --setenv=XDG_DATA_DIRS --setenv=XDG_CONFIG_DIRS --setenv=XDG_MENU_PREFIX \
		--setenv=KDE_FULL_SESSION --setenv=KDE_SESSION_VERSION --setenv=DESKTOP_SESSION \
		-- "$0" "$@"
fi
current() {
	case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" in
	*HexLight) echo "hex light" ;;
	*Hex) echo "hex dark" ;;
	*Light) echo "horizon light" ;;
	*) echo "horizon dark" ;;
	esac
}
# "refresh startup": the session has just started; the dock has too.
startup="${2:-}"
set -- "${1:-status}"
read -r was_design was_tone <<EOF_
$(current)
EOF_
design="$was_design" tone="$was_tone"
case "$1" in
dark | light) tone="$1" ;;
horizon | hex) design="$1" ;;
horizon-dark | horizon-light | hex-dark | hex-light) design="${1%-*}" tone="${1#*-}" ;;
toggle) if [ "$tone" = light ]; then tone=dark; else tone=light; fi ;;
refresh) ;;
status)
	if [ "$was_design" = hex ]; then
		[ "$was_tone" = light ] && echo hex-light || echo hex
	else
		echo "$was_tone"
	fi
	exit 0
	;;
*)
	echo "usage: cybroid-appearance dark|light|hex|horizon|toggle|refresh|status" >&2
	exit 2
	;;
esac
case "$design-$tone" in
horizon-light)
	kv=CybroidOSLight style_engine=kvantum scheme=CybroidHorizonLight style=cybroid-light icons=WhiteSur-light
	deco=__aurorae__svg__CybroidOS-Light lnf=org.cybroid.desktop.light dock=CybroidOS-Light wall=cybroid-light
	radius=18 look=card cw=300 ch=176
	;;
horizon-dark)
	kv=CybroidOS style_engine=kvantum scheme=CybroidHorizon style=cybroid icons=WhiteSur-dark
	deco=__aurorae__svg__CybroidOS lnf=org.cybroid.desktop dock=CybroidOS wall=cybroid
	radius=18 look=card cw=300 ch=176
	;;
hex-dark)
	kv=CybroidHex style_engine=kvantum scheme=CybroidHex style=cybroid-hex icons=CybroidOS-Hex
	deco=org.cybroid.hex lnf=org.cybroid.hex dock=CybroidOS-Hex wall=cybroid-hex
	radius=2 look=hud cw=320 ch=196
	;;
hex-light)
	kv=CybroidHexLight style_engine=kvantum scheme=CybroidHexLight style=cybroid-hex-light icons=CybroidOS-Hex-Light
	deco=org.cybroid.hex lnf=org.cybroid.hex.light dock=CybroidOS-Hex-Light wall=cybroid-hex-light
	radius=2 look=hud cw=320 ch=196
	;;
esac
mode="$1"
# Between designs, the new design's wallpaper covers the screens from the
# first change to the desktop drawn again (cybroid-curtain): no half-changed
# desktop and no black second while it restarts. The changes start once the
# cover is fully shown (its .shown file; 3 s at most).
curtain=""
if [ "$mode" != refresh ] && [ "$design" != "$was_design" ] && [ -x /usr/libexec/cybroid/cybroid-curtain ]; then
	curtain="${XDG_RUNTIME_DIR:-/tmp}/cybroid-curtain.$$"
	: > "$curtain"
	# However this ends (an error stops it: set -e), the cover goes.
	trap 'rm -f "$curtain" "$curtain.shown"' EXIT
	/usr/libexec/cybroid/cybroid-curtain "/usr/share/backgrounds/cybroid/$wall-1920x1080.png" "$curtain" >/dev/null 2>&1 &
	for _ in $(seq 1 60); do
		[ -e "$curtain.shown" ] && break
		sleep 0.05
	done
	rm -f "$curtain.shown"
fi
# A screen change only moves the wallpaper and widgets: the theme stays.
if [ "$mode" != refresh ]; then
kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$lnf"
# System Settings' Quick Settings offers a light and a dark theme: the two of
# the design in use, so it never swaps Hex for Horizon.
if [ "$design" = hex ]; then
	kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel org.cybroid.hex.light
	kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel org.cybroid.hex
else
	kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel org.cybroid.desktop.light
	kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel org.cybroid.desktop
fi
# App controls: Kvantum in the design's theme (CybroidOS* or CybroidHex*); apps
# already open take it when next opened.
kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle "$style_engine"
kvdir="${XDG_CONFIG_HOME:-$HOME/.config}/Kvantum"
mkdir -p "$kvdir"
printf '[General]\ntheme=%s\n' "$kv" > "$kvdir/kvantum.kvconfig"
# Text editors (KWrite, Kate): Hex's own colours for the writing area
# (tools/editor-theme.py); Horizon goes back to choosing by light or dark.
for rc in kwriterc katerc; do
	if [ "$design" = hex ]; then
		kwriteconfig6 --file "$rc" --group "KTextEditor Renderer" --key "Auto Color Theme Selection" false
		kwriteconfig6 --file "$rc" --group "KTextEditor Renderer" --key "Color Theme" "$([ "$tone" = light ] && echo "CybroidOS Hex Light" || echo "CybroidOS Hex")"
	else
		kwriteconfig6 --file "$rc" --group "KTextEditor Renderer" --key "Auto Color Theme Selection" true
	fi
done
plasma-apply-colorscheme "$scheme" >/dev/null
plasma-apply-desktoptheme "$style" >/dev/null
for c in /usr/lib/*/libexec/plasma-changeicons /usr/libexec/plasma-changeicons; do
	if [ -x "$c" ]; then
		"$c" "$icons" >/dev/null 2>&1 || true
		break
	fi
done
# Window title bars (Horizon's are Aurorae SVG themes; Hex's is QML, for the
# tab its title sits in), and the corners the rounded-corners effect cuts.
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$deco"
# Hex's title bar draws Dark or Light as its own setting says.
kwriteconfig6 --file auroraerc --group org.cybroid.hex --key light "$([ "$tone" = light ] && echo true || echo false)"
kwriteconfig6 --file kwinrc --group Round-Corners --key Size "$radius"
kwriteconfig6 --file kwinrc --group Round-Corners --key InactiveCornerRadius "$radius"
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true

# GTK apps and the dock read their icons from GTK's settings.
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/gtk-3.0/settings.ini "${XDG_CONFIG_HOME:-$HOME/.config}"/gtk-4.0/settings.ini; do
	[ -f "$f" ] && sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/" "$f"
done
gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true

# The dock (Plank keeps its settings in dconf); it loads icons once, so it
# starts again with the new ones.
gsettings set net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ theme "$dock" 2>/dev/null || true
# Started again in a service of its own (dock-start; this script's service
# would take it down when it ends), and started too if it wasn't running.
/usr/libexec/cybroid/dock-start
elif [ "$startup" != startup ]; then
	# Plank stays where it was on the old screen size: centred again.
	/usr/libexec/cybroid/dock-start
fi

# The wallpaper (where it is CybroidOS's own: a picture someone chose stays) and
# the desktop widgets: Horizon's two cards at the top corners, or Hex's two
# readout columns beside the wallpaper's dial.
img="file:///usr/share/backgrounds/cybroid/$wall-1920x1080.png"
places="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
var hex = '$design' == 'hex';
// The Hex picture drawn for the shape nearest the screen's (render-brand.py,
// HEX_SIZES), in the smallest size at least as wide; the widgets pick it the
// same way (hexPick in org.cybroid.widgets). Keep the three in step.
function hexPick(W, H) {
    var shapes = [[1920, 1080], [2560, 1440], [3840, 2160], [1920, 1200], [2560, 1600],
        [1600, 1200], [1280, 1024], [2560, 1080], [3440, 1440], [5120, 1440], [1080, 1920]];
    var la = Math.log(W / H), best = 1e9, near = [];
    for (var i = 0; i < shapes.length; i++) best = Math.min(best, Math.abs(Math.log(shapes[i][0] / shapes[i][1]) - la));
    for (var i = 0; i < shapes.length; i++) if (Math.abs(Math.log(shapes[i][0] / shapes[i][1]) - la) <= best + 0.02) near.push(shapes[i]);
    near.sort(function (a, b) { return a[0] - b[0]; });
    for (var i = 0; i < near.length; i++) if (near[i][0] >= W) return near[i];
    return near[near.length - 1];
}
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    var g = screenGeometry(d.screen);
    var pk = hexPick(g.width, g.height), Wp = pk[0], Hp = pk[1];
    var img = hex ? 'file:///usr/share/backgrounds/cybroid/$wall-' + Wp + 'x' + Hp + '.png' : '$img';
    if (d.wallpaperPlugin == 'org.kde.image') {
        d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
        var cur = String(d.readConfig('Image'));
        // Written only when it changes: Plasma draws the wallpaper again on
        // every write, a blink each time Control Centre changed something.
        if ((cur == '' || cur.indexOf('/backgrounds/cybroid/') >= 0) && cur != img) {
            d.writeConfig('Image', img);
            d.writeConfig('FillMode', 2);
        }
    }
    var all = d.widgets('org.cybroid.widgets');
    if (all.length == 0) continue;
    // A title widget (card 'title') from an earlier build is taken away.
    var ws = [];
    for (var j = 0; j < all.length; j++) {
        all[j].currentConfigGroup = ['General'];
        if (all[j].readConfig('card') == 'title') all[j].remove();
        else ws.push(all[j]);
    }
    // Hex: two columns between the frame and the ends of the dial's leaders
    // (render-brand.py, HEX_*: in the design's unit u, the dial 10 above the
    // middle, the columns 764 tall from 434 above it, from 80 inside the
    // frame to 456 from the centre line, at most 520 wide on ultrawides).
    // Portrait screens have no room beside the dial: the readouts go in a
    // band above it and one below, clear of the dock.
    var up = Math.min(Hp / 1080, Wp / 1800), s = Math.max(g.width / Wp, g.height / Hp);
    var ox = (g.width - Wp * s) / 2, oy = (g.height - Hp * s) / 2, U = s * up;
    var cy = oy + s * (Hp / 2 - 10 * up), cx = g.width / 2;
    var lr, rr;
    if (g.width < g.height) {
        var bx = Math.max(16, Math.round(ox + 80 * U)), bw = g.width - 2 * bx;
        // Below the top bar even where the picture is cropped (a 10:16 screen).
        var ty = Math.max(64, Math.round(oy + s * (30 + 22 * up) + 80 * U)), by = Math.round(cy + 330 * U);
        lr = [bx, ty, bw, Math.round(cy - 330 * U) - ty];
        // The dock is about 90 tall with its gap: keep the band clear of it.
        rr = [bx, by, bw, g.height - 180 - by];
    } else {
        var top = Math.round(cy - 434 * U), colH = Math.round(764 * U);
        var lx = Math.max(16, Math.round(Math.max(ox + 80 * U, cx - 976 * U))), lw = Math.round(cx - 456 * U) - lx;
        var rx = Math.round(cx + 456 * U), rw = Math.min(g.width - 16, Math.round(Math.min(ox + Wp * s - 80 * U, cx + 976 * U))) - rx;
        lr = [lx, top, lw, colH];
        rr = [rx, top, rw, colH];
    }
    var places = '';
    for (var j = 0; j < ws.length; j++) {
        ws[j].currentConfigGroup = ['General'];
        ws[j].writeConfig('look', '$look');
        var right = ws[j].readConfig('card') == 'system';
        var r = hex ? (right ? rr : lr) : [right ? g.width - $cw - 40 : 40, 56, $cw, $ch];
        places += 'Applet-' + ws[j].id + ':' + r.join(',') + ',0;';
    }
    d.currentConfigGroup = [];
    // print() adds no line break: each screen's line ends with its own.
    if (String(d.readConfig('ItemGeometries-' + g.width + 'x' + g.height)) != places) print('moved\n');
    d.writeConfig('ItemGeometries-' + g.width + 'x' + g.height, places);
    d.writeConfig('ItemGeometriesHorizontal', places);
    print(d.id + ' ' + g.width + 'x' + g.height + ' ' + places + '\n');
}" 2>/dev/null || true)"
lock="$(kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image)"
case "$lock" in
"" | *"/backgrounds/cybroid/"*)
	kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "$img"
	kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "$img"
	;;
esac
# Between designs the widgets change size, which the desktop takes only as it
# starts. It also saves its own places as it stops, so it is stopped first,
# the new places written, then started (a moment's blink).
# On a screen change, only when a widget's place for this screen size isn't
# the one the desktop had (the script says "moved").
moved=""
if [ "$mode" = refresh ]; then
	case "$places" in *moved*) moved=yes ;; esac
fi
if [ "$design" != "$was_design" ] || [ -n "$moved" ]; then
	if systemctl --user stop plasma-plasmashell >/dev/null 2>&1; then
		printf '%s\n' "$places" | while read -r cid size where; do
			[ -n "$where" ] || continue
			for key in "ItemGeometries-$size" ItemGeometriesHorizontal; do
				kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group Containments --group "$cid" --key "$key" "$where"
			done
		done
		# Several screen changes in a row (a monitor plugged in and out)
		# restart it quickly: systemd's start limit must not leave the
		# desktop down.
		systemctl --user reset-failed plasma-plasmashell >/dev/null 2>&1 || true
		systemctl --user start plasma-plasmashell >/dev/null 2>&1 ||
			{ sleep 2; systemctl --user reset-failed plasma-plasmashell >/dev/null 2>&1; systemctl --user start plasma-plasmashell >/dev/null 2>&1; } || true
	fi
	if [ -n "$curtain" ]; then
		# The desktop is drawn once its shell answers on D-Bus and has had
		# a moment to paint; then the cover fades away (at most 20 s).
		for _ in $(seq 1 60); do
			qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && break
			sleep 0.25
		done
		sleep 1.2
		rm -f "$curtain"
		sleep 0.4
	fi
fi
"$0" status
