#!/bin/sh
# Applies the CybroidOS Horizon Plasma Style once per person (cybroid-plasma).
# It's the default in /etc/xdg/plasmarc, but Plasma can draw the standard
# style at a first sign-in until the style is applied in the session; doing
# it once here makes the first sign-in look right. After that, a person's
# own choice stands.
mark="${XDG_CONFIG_HOME:-$HOME/.config}/cybroid/plasma-look-set"
[ -f "$mark" ] && exit 0
sleep 3
plasma-apply-desktoptheme cybroid >/dev/null 2>&1 || exit 0
mkdir -p "$(dirname "$mark")" && : > "$mark"
