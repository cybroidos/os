# Your zsh settings. CybroidOS's own (suggestions as you type, Tab to take
# them, Ctrl+R to search your history, colours, the prompt) come from the
# file below and arrive with updates; add your own after it.
[ -r /usr/share/cybroid/zsh/cybroid.zsh ] && . /usr/share/cybroid/zsh/cybroid.zsh

