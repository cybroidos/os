#!/bin/sh
# Starts the CybroidOS dock (Plank). The first time, it puts the CybroidOS apps
# in it, with the Trash at the end as on a Mac (a launcher for Files' trash:/;
# Plank's own Trash docklet needs GNOME's gvfs); after that the person's own
# arrangement stands. Launchers point at the renamed copies (Files,
# Terminal...) where app-names made one, so the dock shows the same names.
conf="${XDG_CONFIG_HOME:-$HOME/.config}"
dir="$conf/plank/dock1/launchers"
if [ ! -f "$conf/cybroid/dock-set" ]; then
	mkdir -p "$dir"
	apps="cybroid-apps firefox-esr org.kde.dolphin org.kde.konsole org.kde.kwrite cybroid-settings cybroid-trash"
	# The live system (the ISO): "Install CybroidOS" comes first.
	[ -d /run/live/medium ] && apps="install-debian ${apps}"
	for a in ${apps}; do
		f=/usr/share/cybroid/apps/applications/$a.desktop
		# Apps whose windows don't name their .desktop file (Firefox): the
		# dock's matcher (BAMF) ties them to the original, so the launcher
		# is the original too, or the running app shows as a second icon.
		case "$a" in firefox-esr) f=/usr/share/applications/$a.desktop ;; esac
		[ -f "$f" ] || f=/usr/share/applications/$a.desktop
		[ -f "$f" ] || continue
		printf '[PlankDockItemPreferences]\nLauncher=file://%s\n' "$f" > "$dir/$a.dockitem"
		items="${items:+$items, }'$a.dockitem'"
	done
	# The order too: Plank puts items its settings don't list at the end
	# (the live system's installer went last instead of first).
	gsettings set net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ dock-items "[$items]" 2>/dev/null || true
	mkdir -p "$conf/cybroid" && : > "$conf/cybroid/dock-set"
fi
# Firefox's launcher, set before 0.1.6 to the renamed copy: the original
# (see above). Once.
if [ ! -f "$conf/cybroid/firefox-launcher" ] && [ -f "$dir/firefox-esr.dockitem" ]; then
	sed -i 's|file:///usr/share/cybroid/apps/applications/firefox-esr.desktop|file:///usr/share/applications/firefox-esr.desktop|' "$dir/firefox-esr.dockitem"
	mkdir -p "$conf/cybroid" && : > "$conf/cybroid/firefox-launcher"
fi
# CybroidOS 0.1.3 has its own Settings (cybroid-settings): a dock set up
# before then has KDE's in its place, switched over once.
if [ ! -f "$conf/cybroid/settings-in-dock" ] && [ -f /usr/share/applications/cybroid-settings.desktop ]; then
	if [ -f "$dir/systemsettings.dockitem" ] && [ ! -f "$dir/cybroid-settings.dockitem" ]; then
		printf '[PlankDockItemPreferences]\nLauncher=file:///usr/share/applications/cybroid-settings.desktop\n' > "$dir/cybroid-settings.dockitem"
		order="$(gsettings get net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ dock-items 2>/dev/null)"
		case "$order" in *systemsettings.dockitem*)
			gsettings set net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ dock-items \
				"$(printf '%s' "$order" | sed 's/systemsettings\.dockitem/cybroid-settings.dockitem/')" 2>/dev/null || true
			;;
		esac
		rm -f "$dir/systemsettings.dockitem"
	fi
	mkdir -p "$conf/cybroid" && : > "$conf/cybroid/settings-in-dock"
fi
# Terminal without its toolbars (New Tab, Split View...), as on a Mac: KDE
# keeps that in the window's saved state (Konsole's own, captured once).
# Once per account (a marker, not "no state file yet": a state file made
# before this ran kept the toolbars), changing only that value, so the
# window's size stays; anyone can show them again.
st="${XDG_STATE_HOME:-$HOME/.local/state}/konsolestaterc"
if [ ! -f "$conf/cybroid/konsole-toolbars" ]; then
	mkdir -p "$(dirname "$st")" "$conf/cybroid"
	kwriteconfig6 --file "$st" --group MainWindow --key State '' 2>/dev/null ||
		printf '[MainWindow]\\n' > "$st"
	: > "$conf/cybroid/konsole-toolbars"
fi

# No Templates folder (macOS has none, and its icon looked like the App
# Store's): switched off in the user folders and removed while empty. Once.
if [ ! -f "$conf/cybroid/templates-off" ] && command -v xdg-user-dirs-update >/dev/null; then
	xdg-user-dirs-update --set TEMPLATES "$HOME" 2>/dev/null || true
	rmdir "$HOME/Templates" 2>/dev/null || true
	mkdir -p "$conf/cybroid" && : > "$conf/cybroid/templates-off"
fi

# Float the dock a little above the screen's edge, as macOS does (our
# Plank build reads this; tools/plank-edge-gap.py). In Hex, running apps
# are marked by a small hexagon (cyan, or CIT blue in Hex Light) instead of
# a glowing dot.
# Hex's dock stands on the wallpaper's frame, just above the notch in its
# foot: 46 px up on a screen 1080 high (render-brand.py, hex_wallpaper).
gap=8
case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)" in
*Hex | *HexLight)
	case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" in
	*HexLight) export PLANK_INDICATOR="#1f5fe0" ;;
	*) export PLANK_INDICATOR="#1ccbff" ;;
	esac
	h="$(xdpyinfo 2>/dev/null | sed -n 's/^ *dimensions: *[0-9]*x\([0-9]*\) pixels.*/\1/p' | head -1)"
	[ -n "$h" ] && gap=$((46 * h / 1080))
	;;
esac
PLANK_EDGE_GAP=$gap exec plank
