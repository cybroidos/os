#!/bin/sh
set -e

# CybroidOS was CIT-OS until 0.1.2. The old citos-* package is now empty, and
# dpkg keeps its settings files on disk as "obsolete" (a sources list, sign-in
# and GRUB settings under the old names, read beside the new ones). Remove
# those the new package doesn't own; an edited one is kept as .dpkg-old.
drop_citos_conffiles() {
	old="$1" new="$2"
	dpkg-query -W -f='${Conffiles}\n' "${old}" 2>/dev/null | awk '$3 == "obsolete" { print $1, $2 }' |
	while read -r f sum; do
		[ -e "${f}" ] || continue
		dpkg-query -W -f='${Conffiles}\n' "${new}" 2>/dev/null | awk '{ print $1 }' | grep -qxF "${f}" && continue
		if [ "$(md5sum < "${f}" | cut -d' ' -f1)" = "${sum}" ]; then
			rm -f "${f}"
		else
			mv -f "${f}" "${f}.dpkg-old"
		fi
	done
}
if [ "$1" = "configure" ]; then
	drop_citos_conffiles citos-base cybroid-base
fi

# /etc/issue and /etc/motd are conffiles owned by base-files and are not shipped
# as package files (that would trigger a conffile prompt). preinst divers
# base-files' copies aside; here we install our branded ones in their place.
if [ -f /usr/share/cybroid/issue ]; then
	cp /usr/share/cybroid/issue /etc/issue
fi
if [ -f /usr/share/cybroid/motd ]; then
	cp /usr/share/cybroid/motd /etc/motd
fi
if [ -f /usr/share/cybroid/10-uname ] && [ -d /etc/update-motd.d ]; then
	install -m 0755 /usr/share/cybroid/10-uname /etc/update-motd.d/10-uname
fi

# The dpkg vendor: CybroidOS, whose parent is Debian (etc/dpkg/origins/cybroid).
if [ -f /etc/dpkg/origins/cybroid ]; then
	ln -sfn cybroid /etc/dpkg/origins/default
fi

# /etc/os-release points at ours now, not only from the next boot
# (usr/lib/tmpfiles.d/cybroid-os-release.conf keeps it so).
if command -v systemd-tmpfiles >/dev/null 2>&1; then
	systemd-tmpfiles --create cybroid-os-release.conf >/dev/null 2>&1 || true
fi

# The boot menu says CybroidOS (/etc/default/grub.d/50-cybroid.cfg).
if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then
	update-grub >/dev/null 2>&1 || true
fi

exit 0
