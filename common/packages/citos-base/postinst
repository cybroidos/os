#!/bin/sh
set -e

# /etc/issue and /etc/motd are conffiles owned by base-files and are not shipped
# as package files (that would trigger a conffile prompt). preinst divers
# base-files' copies aside; here we install our branded ones in their place.
if [ -f /usr/share/citos/issue ]; then
	cp /usr/share/citos/issue /etc/issue
fi
if [ -f /usr/share/citos/motd ]; then
	cp /usr/share/citos/motd /etc/motd
fi
if [ -f /usr/share/citos/10-uname ] && [ -d /etc/update-motd.d ]; then
	install -m 0755 /usr/share/citos/10-uname /etc/update-motd.d/10-uname
fi

# /etc/os-release points at ours now, not only from the next boot
# (usr/lib/tmpfiles.d/citos-os-release.conf keeps it so).
if command -v systemd-tmpfiles >/dev/null 2>&1; then
	systemd-tmpfiles --create citos-os-release.conf >/dev/null 2>&1 || true
fi

# The boot menu says CIT-OS (/etc/default/grub.d/50-citos.cfg).
if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then
	update-grub >/dev/null 2>&1 || true
fi

exit 0
