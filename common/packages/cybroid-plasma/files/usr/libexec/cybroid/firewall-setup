#!/bin/sh
# CybroidOS (cybroid-plasma): the firewall, set once on the first start
# (ufw needs the running kernel, not the image builder's chroot). Nothing
# comes in except Remote Desktop and SSH over Tower, Cybroid's private
# network, and KDE Connect from phones on the same network; everything goes
# out. Also run (rules only, no reset) when cybroid-plasma is upgraded. Each person can change it in Settings > Firewall.
set -e
command -v ufw >/dev/null || exit 0
rules() {
	ufw allow in on tailscale0 to any port 3389 proto tcp comment 'Remote Desktop over Tower' >/dev/null
	ufw allow in on tailscale0 to any port 22 proto tcp comment 'SSH over Tower' >/dev/null
	ufw allow 1714:1764/tcp comment 'KDE Connect' >/dev/null
	ufw allow 1714:1764/udp comment 'KDE Connect' >/dev/null
}
# Upgrades: add rules this version brings, keep the person's own.
if [ "${1:-}" = --add-rules ]; then
	[ -e /var/lib/cybroid/firewall-set ] && ufw status | grep -q '^Status: active' && rules
	exit 0
fi
ufw --force reset >/dev/null
ufw default deny incoming >/dev/null
ufw default allow outgoing >/dev/null
rules
ufw --force enable >/dev/null
mkdir -p /var/lib/cybroid && : > /var/lib/cybroid/firewall-set
