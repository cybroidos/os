#!/bin/sh
# Gives each Xfce session the CIT-OS wallpaper on every screen still showing
# Xfce's default, until the person picks their own. A screen's name differs
# between the console and Remote Desktop, so this runs at every sign-in.
# (The theme, icons, fonts and panels are system defaults in
# /etc/xdg/xfce4/xfconf: nothing to do for them here.)
WALL=/usr/share/backgrounds/citos/citos-1920x1080.png
[ -f "$WALL" ] || exit 0
command -v xfconf-query >/dev/null || exit 0
sleep 4 # xfdesktop makes its properties as it starts
for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'); do
	cur=$(xfconf-query -c xfce4-desktop -p "$p" 2>/dev/null)
	case "$cur" in "" | */backgrounds/xfce/*) xfconf-query -c xfce4-desktop -p "$p" -s "$WALL" ;; esac
done
