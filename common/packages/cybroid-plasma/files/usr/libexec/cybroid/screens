#!/bin/sh
# CybroidOS (cybroid-plasma): keep the desktop drawn for the screens as they
# are. When a monitor is plugged in or taken out, or a resolution changes,
# the Hex wallpaper is drawn for each screen's own shape (16:9, 16:10, 4:3,
# 5:4, ultrawide, portrait) and the readouts placed beside its dial
# (cybroid-appearance refresh). X sends several events for one change; this
# waits until they stop and acts only if the monitors really changed.
command -v xev >/dev/null 2>&1 || exit 0
state="${XDG_RUNTIME_DIR:-/tmp}/cybroid-screens"
monitors() { xrandr --listmonitors 2>/dev/null | md5sum | cut -d' ' -f1; }
monitors > "${state}"
# The screen may not be the size it was when the desktop was last drawn (a
# laptop that was last on a projector, a VM window): draw it for this one.
cybroid-appearance refresh startup >/dev/null 2>&1 &
xev -root -event randr | while read -r line; do
	case "${line}" in RRScreenChangeNotify*) ;; *) continue ;; esac
	(
		sleep 2
		exec 9>"${state}.lock"
		flock -n 9 || exit 0
		now="$(monitors)"
		[ "${now}" = "$(cat "${state}" 2>/dev/null)" ] && exit 0
		printf '%s\n' "${now}" > "${state}"
		cybroid-appearance refresh >/dev/null 2>&1
	) &
done
