#!/bin/bash
# CybroidOS installer: prepare GRUB on the new system before Calamares
# installs it (in place of calamares-settings-debian's helper, which ran
# "apt-get install grub-efi" or "grub-pc": that needs a package source, and
# the live ISO has none, so every install failed here). The image already
# has GRUB (grub-efi-amd64-bin and -signed, shim, grub-pc-bin, grub2-common);
# this gives the new system GRUB's settings file and its menu. Calamares'
# bootloader step then puts GRUB on the disk.
set -u
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
[ -n "${CHROOT}" ] || { echo "No target mounted." >&2; exit 1; }

echo "Running bootloader-config (CybroidOS)..."

# Encrypted disks: the initramfs only readable by root (it holds the key).
if [ "$(mount | grep "${CHROOT} " | cut -c -16)" = "/dev/mapper/luks" ]; then
	mkdir -p "${CHROOT}/etc/initramfs-tools/conf.d"
	echo "UMASK=0077" > "${CHROOT}/etc/initramfs-tools/conf.d/initramfs-permissions"
fi

# GRUB's settings, from its own template (grub-pc or grub-efi-amd64 would
# have written it).
if [ ! -f "${CHROOT}/etc/default/grub" ] && [ -f "${CHROOT}/usr/share/grub/default/grub" ]; then
	cp "${CHROOT}/usr/share/grub/default/grub" "${CHROOT}/etc/default/grub"
fi
# Other systems on the disk (Windows) in the menu.
if [ -f "${CHROOT}/etc/default/grub" ]; then
	if grep -q '^#GRUB_DISABLE_OS_PROBER=false' "${CHROOT}/etc/default/grub"; then
		sed -i 's/^#GRUB_DISABLE_OS_PROBER=false/GRUB_DISABLE_OS_PROBER=false/' "${CHROOT}/etc/default/grub"
	elif ! grep -q '^GRUB_DISABLE_OS_PROBER=' "${CHROOT}/etc/default/grub"; then
		echo 'GRUB_DISABLE_OS_PROBER=false' >> "${CHROOT}/etc/default/grub"
	fi
fi
mkdir -p "${CHROOT}/boot/grub"
chroot "${CHROOT}" /usr/sbin/update-grub || true
exit 0
