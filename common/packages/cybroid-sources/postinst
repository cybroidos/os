#!/bin/sh
set -e

# CybroidOS was CIT-OS until 0.1.2. The old citos-* package is now empty, and
# dpkg keeps its settings files on disk as "obsolete" (a sources list, sign-in
# and GRUB settings under the old names, read beside the new ones). Remove
# those the new package doesn't own; an edited one is kept as .dpkg-old.
drop_citos_conffiles() {
	old="$1" new="$2"
	dpkg-query -W -f='${Conffiles}\n' "${old}" 2>/dev/null | awk '$3 == "obsolete" { print $1, $2 }' |
	while read -r f sum; do
		[ -e "${f}" ] || continue
		dpkg-query -W -f='${Conffiles}\n' "${new}" 2>/dev/null | awk '{ print $1 }' | grep -qxF "${f}" && continue
		if [ "$(md5sum < "${f}" | cut -d' ' -f1)" = "${sum}" ]; then
			rm -f "${f}"
		else
			mv -f "${f}" "${f}.dpkg-old"
		fi
	done
}
if [ "$1" = "configure" ]; then
	drop_citos_conffiles citos-sources cybroid-sources
fi
# Sets Debian's own source entries aside, so apt uses cybroid.sources only:
# the deb822 file Debian's images ship moves to /etc/apt/cybroid-replaced/,
# and deb.debian.org / security.debian.org lines in sources.list are
# commented out with a "#cybroid-off# " mark. postrm undoes both. Only on
# Debian 13 (trixie), which cybroid.sources describes.
case "$(cat /etc/debian_version 2>/dev/null)" in 13* | trixie*) ;; *)
	echo "cybroid-sources: not Debian 13; leaving apt's sources as they are" >&2
	exit 0
	;;
esac
keep=/etc/apt/cybroid-replaced
f=/etc/apt/sources.list.d/debian.sources
if [ -f "$f" ] && grep -qE 'deb\.debian\.org|security\.debian\.org|mirror\+file:///etc/apt/mirrors/debian' "$f"; then
	mkdir -p "$keep"
	mv "$f" "$keep/"
fi
if [ -f /etc/apt/sources.list ]; then
	sed -i -E 's@^([[:space:]]*deb(-src)?[[:space:]].*(deb\.debian\.org|security\.debian\.org).*)$@#cybroid-off# \1@' /etc/apt/sources.list
fi
exit 0
