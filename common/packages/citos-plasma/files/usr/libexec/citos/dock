#!/bin/sh
# Starts the CIT-OS dock (Plank). The first time, it puts the CIT-OS apps
# in it, with the Trash at the end as on a Mac (a launcher for Files' trash:/;
# Plank's own Trash docklet needs GNOME's gvfs); after that the person's own
# arrangement stands. Launchers point at the renamed copies (Files,
# Terminal...) where app-names made one, so the dock shows the same names.
conf="${XDG_CONFIG_HOME:-$HOME/.config}"
dir="$conf/plank/dock1/launchers"
if [ ! -f "$conf/citos/dock-set" ]; then
	mkdir -p "$dir"
	apps="citos-apps firefox-esr org.kde.dolphin org.kde.konsole org.kde.kwrite systemsettings citos-trash"
	# The live system (the ISO): "Install CIT-OS" comes first.
	[ -d /run/live/medium ] && apps="install-debian ${apps}"
	for a in ${apps}; do
		f=/usr/share/citos/apps/applications/$a.desktop
		[ -f "$f" ] || f=/usr/share/applications/$a.desktop
		[ -f "$f" ] || continue
		printf '[PlankDockItemPreferences]\nLauncher=file://%s\n' "$f" > "$dir/$a.dockitem"
	done
	mkdir -p "$conf/citos" && : > "$conf/citos/dock-set"
fi
# Terminal without its toolbars (New Tab, Split View...), as on a Mac: KDE
# keeps that in the window's saved state, so a first sign-in gets one with
# both hidden (Konsole's own, captured once); anyone can show them again.
st="${XDG_STATE_HOME:-$HOME/.local/state}/konsolestaterc"
if [ ! -f "$st" ]; then
	mkdir -p "$(dirname "$st")"
	printf '[MainWindow]\\n' > "$st"
fi

# No Templates folder (macOS has none, and its icon looked like the App
# Store's): switched off in the user folders and removed while empty. Once.
if [ ! -f "$conf/citos/templates-off" ] && command -v xdg-user-dirs-update >/dev/null; then
	xdg-user-dirs-update --set TEMPLATES "$HOME" 2>/dev/null || true
	rmdir "$HOME/Templates" 2>/dev/null || true
	mkdir -p "$conf/citos" && : > "$conf/citos/templates-off"
fi

# Float the dock a little above the screen's edge, as macOS does (our
# Plank build reads this; tools/plank-edge-gap.py). In Hex, running apps
# are marked by a small cyan hexagon instead of a glowing dot.
# Hex's dock stands on the wallpaper's frame, just above the notch in its
# foot: 46 px up on a screen 1080 high (render-brand.py, hex_wallpaper).
gap=8
case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)" in
*Hex)
	export PLANK_INDICATOR="#1ccbff"
	h="$(xdpyinfo 2>/dev/null | sed -n 's/^ *dimensions: *[0-9]*x\([0-9]*\) pixels.*/\1/p' | head -1)"
	[ -n "$h" ] && gap=$((46 * h / 1080))
	;;
esac
PLANK_EDGE_GAP=$gap exec plank
