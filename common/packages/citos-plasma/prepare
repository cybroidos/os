#!/bin/sh
# Generated parts of citos-plasma: the CIT-OS Horizon Plasma Style
# (tools/plasma-style.py), the CIT-OS window decoration (tools/aurorae-theme.py)
# and Hex's dock icons (tools/hex-icons.py).
set -eu
python3 "$2/tools/plasma-style.py" "$1" >/dev/null
python3 "$2/tools/aurorae-theme.py" "$1" >/dev/null
python3 "$2/tools/hex-icons.py" "$1" >/dev/null
