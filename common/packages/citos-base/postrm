#!/bin/sh
set -e

# Undo the diversions set up in preinst (restores base-files' originals).
# Our /etc/issue and /etc/motd were copied in by postinst, not shipped, so
# delete them first or the rename back would find the path taken.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	rm -f /etc/issue /etc/motd /etc/update-motd.d/10-uname
	for f in /usr/lib/os-release /etc/issue /etc/motd /etc/update-motd.d/10-uname; do
		dpkg-divert --package citos-base --remove --rename \
			--divert "${f}.base-files" "$f" || true
	done
fi

exit 0
