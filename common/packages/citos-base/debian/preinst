#!/bin/sh
set -e

# Brand system identity files owned by base-files by diverting them aside, so
# our shipped versions in /etc/issue and /usr/lib/os-release take effect.
# Redirecting /etc/issue and /usr/lib/os-release means we do not have to
# Conflict/Replaces base-files (which is Essential).
if [ "$1" = "install" ]; then
	for f in /usr/lib/os-release /etc/issue; do
		dpkg-divert --package citos-base --add --rename \
			--divert "${f}.base-files" "$f"
	done
fi

#DEBHELPER#

exit 0
