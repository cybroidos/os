<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- CybroidOS: installing editions (cybroid-editions, from the welcome or
     Settings) needs an administrator, asked once for a while. -->
<policyconfig>
  <vendor>CybroidOS</vendor>
  <vendor_url>https://cybroid.com</vendor_url>
  <action id="org.cybroid.editions">
    <description>Install editions</description>
    <message>Installing an edition needs an administrator's password</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/cybroid/cybroid-editions</annotate>
  </action>
</policyconfig>
