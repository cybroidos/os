#!/bin/sh
set -e
# xfce4-settings ships its own default xsettings.xml (theme, icons, fonts);
# CIT-OS's takes its place. Debian's copy is diverted aside, not deleted,
# and comes back if citos-desktop is removed.
f=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
	if ! dpkg-divert --list "$f" | grep -q citos-desktop; then
		dpkg-divert --package citos-desktop --add --rename --divert "$f.xfce4-settings" "$f"
	fi
fi
exit 0
