#!/bin/sh
# Generated parts of cybroid-plasma: the CybroidOS Horizon Plasma Style
# (tools/plasma-style.py), the CybroidOS window decoration (tools/aurorae-theme.py)
# Hex's dock icons (tools/hex-icons.py), Hex's app controls (tools/kvantum-hex.py,
# from the CybroidOS Kvantum themes) and the GRUB theme (tools/boot-menu.py).
set -eu
python3 "$2/tools/plasma-style.py" "$1" >/dev/null
python3 "$2/tools/aurorae-theme.py" "$1" >/dev/null
python3 "$2/tools/hex-icons.py" "$1" >/dev/null
python3 "$2/tools/kvantum-hex.py" "$1" >/dev/null
python3 "$2/tools/boot-menu.py" --installed "$1" >/dev/null
