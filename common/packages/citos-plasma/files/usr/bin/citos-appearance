#!/bin/sh
# citos-appearance dark|light|hex|horizon|toggle|status: the CIT-OS design
# and appearance, applied live through Plasma's own tools, as Control
# Centre's Appearance and Design tiles do.
#
#   dark, light   Horizon, the clean design, in Dark or Light
#   horizon       Horizon (Dark)
#   hex           Hex, the HUD design (graphite, amber, live readouts)
#   toggle        Horizon's Dark <-> Light (Hex stays Hex)
#   status        prints dark, light or hex
#
# Each sets: colours, the Plasma style (top bar, popups), icons, window title
# bars and corners, app controls (Kvantum for Horizon, Breeze for Hex), the
# dock, the desktop widgets' look and, where they are CIT-OS's own, the
# wallpaper and lock screen. GTK apps and Firefox follow the colour scheme
# through Plasma's GTK settings.
#
# Not plasma-apply-lookandfeel: it writes the theme as defaults
# (~/.config/kdedefaults), which the running shell and KWin don't reload.
set -eu
current() {
	case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" in
	*Hex) echo hex ;;
	*Light) echo light ;;
	*) echo dark ;;
	esac
}
was="$(current)"
mode="${1:-status}"
case "$mode" in
toggle) if [ "$was" = light ]; then mode=dark; elif [ "$was" = dark ]; then mode=light; else mode=hex; fi ;;
horizon) mode=dark ;;
esac
case "$mode" in
light)
	kv=CIT-OSLight style_engine=kvantum scheme=CITOSHorizonLight style=citos-light icons=WhiteSur-light
	deco=CIT-OS-Light lnf=org.cybroid.citos.desktop.light dock=CIT-OS-Light wall=citos-light
	radius=18 look=card cw=300 ch=176
	;;
dark)
	kv=CIT-OS style_engine=kvantum scheme=CITOSHorizon style=citos icons=WhiteSur-dark
	deco=CIT-OS lnf=org.cybroid.citos.desktop dock=CIT-OS wall=citos
	radius=18 look=card cw=300 ch=176
	;;
hex)
	kv=CIT-OS style_engine=Breeze scheme=CITOSHex style=citos-hex icons=WhiteSur-dark
	deco=CIT-OS-Hex lnf=org.cybroid.citos.hex dock=CIT-OS-Hex wall=citos-hex
	radius=6 look=hud cw=320 ch=196
	;;
status)
	echo "$was"
	exit 0
	;;
*)
	echo "usage: citos-appearance dark|light|hex|horizon|toggle|status" >&2
	exit 2
	;;
esac
kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$lnf"
# App controls: Kvantum in CIT-OS's themes (Horizon) or Breeze (Hex); apps
# already open take it when next opened.
kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle "$style_engine"
kvdir="${XDG_CONFIG_HOME:-$HOME/.config}/Kvantum"
mkdir -p "$kvdir"
printf '[General]\ntheme=%s\n' "$kv" > "$kvdir/kvantum.kvconfig"
plasma-apply-colorscheme "$scheme" >/dev/null
plasma-apply-desktoptheme "$style" >/dev/null
for c in /usr/lib/*/libexec/plasma-changeicons /usr/libexec/plasma-changeicons; do
	if [ -x "$c" ]; then
		"$c" "$icons" >/dev/null 2>&1 || true
		break
	fi
done
# Window title bars, and the corners the rounded-corners effect cuts to match.
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "__aurorae__svg__$deco"
kwriteconfig6 --file kwinrc --group Round-Corners --key Size "$radius"
kwriteconfig6 --file kwinrc --group Round-Corners --key InactiveCornerRadius "$radius"
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true

# GTK apps and the dock read their icons from GTK's settings.
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/gtk-3.0/settings.ini "${XDG_CONFIG_HOME:-$HOME/.config}"/gtk-4.0/settings.ini; do
	[ -f "$f" ] && sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/" "$f"
done
gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true

# The dock (Plank keeps its settings in dconf); it loads icons once, so it
# starts again with the new ones.
gsettings set net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ theme "$dock" 2>/dev/null || true
if pkill -x plank 2>/dev/null; then
	sleep 0.5
	(setsid /usr/libexec/citos/dock >/dev/null 2>&1 &)
fi

# The wallpaper (where it is CIT-OS's own: a picture someone chose stays) and
# the desktop widgets' look, kept as a matching pair at the top corners.
img="file:///usr/share/backgrounds/citos/$wall-1920x1080.png"
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    if (d.wallpaperPlugin == 'org.kde.image') {
        d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
        var cur = String(d.readConfig('Image'));
        if (cur == '' || cur.indexOf('/backgrounds/citos/') >= 0) d.writeConfig('Image', '$img');
    }
    var g = screenGeometry(d.screen);
    var ws = d.widgets('org.cybroid.citos.widgets');
    if (ws.length == 0) continue;
    var places = '';
    for (var j = 0; j < ws.length; j++) {
        ws[j].currentConfigGroup = ['General'];
        ws[j].writeConfig('look', '$look');
        var right = ws[j].readConfig('card') == 'system';
        places += 'Applet-' + ws[j].id + ':' + (right ? g.width - $cw - 40 : 40) + ',56,$cw,$ch,0;';
    }
    d.currentConfigGroup = [];
    d.writeConfig('ItemGeometries-' + g.width + 'x' + g.height, places);
    d.writeConfig('ItemGeometriesHorizontal', places);
}" >/dev/null 2>&1 || true
lock="$(kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image)"
case "$lock" in
"" | *"/backgrounds/citos/"*)
	kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "$img"
	kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "$img"
	;;
esac
# Between designs the widgets change size: the desktop takes the new places
# when it starts again (a moment's blink).
if { [ "$mode" = hex ] && [ "$was" != hex ]; } || { [ "$mode" != hex ] && [ "$was" = hex ]; }; then
	systemctl --user restart plasma-plasmashell >/dev/null 2>&1 || true
fi
echo "$mode"
