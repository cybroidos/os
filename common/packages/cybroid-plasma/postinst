#!/bin/sh
set -e

# CybroidOS was CIT-OS until 0.1.2. The old citos-* package is now empty, and
# dpkg keeps its settings files on disk as "obsolete" (a sources list, sign-in
# and GRUB settings under the old names, read beside the new ones). Remove
# those the new package doesn't own; an edited one is kept as .dpkg-old.
drop_citos_conffiles() {
	old="$1" new="$2"
	dpkg-query -W -f='${Conffiles}\n' "${old}" 2>/dev/null | awk '$3 == "obsolete" { print $1, $2 }' |
	while read -r f sum; do
		[ -e "${f}" ] || continue
		dpkg-query -W -f='${Conffiles}\n' "${new}" 2>/dev/null | awk '{ print $1 }' | grep -qxF "${f}" && continue
		if [ "$(md5sum < "${f}" | cut -d' ' -f1)" = "${sum}" ]; then
			rm -f "${f}"
		else
			mv -f "${f}" "${f}.dpkg-old"
		fi
	done
}
if [ "$1" = "configure" ]; then
	drop_citos_conffiles citos-plasma cybroid-plasma
fi
if [ "$1" = "triggered" ]; then
	/usr/libexec/cybroid/app-names || true
	exit 0
fi
if [ "$1" = "configure" ]; then
	chmod 0755 /usr/libexec/cybroid/plasma-look /usr/libexec/cybroid/dock /usr/libexec/cybroid/app-names /usr/libexec/cybroid/osk
	/usr/libexec/cybroid/app-names || true
	command -v glib-compile-schemas >/dev/null && glib-compile-schemas /usr/share/glib-2.0/schemas || true
	command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
	# Remote Desktop and plain X sessions start Plasma.
	if [ -x /usr/bin/startplasma-x11 ]; then
		update-alternatives --set x-session-manager /usr/bin/startplasma-x11 >/dev/null 2>&1 || true
	fi
	# xrdp reads its TLS key from ssl-cert's group.
	if getent group ssl-cert >/dev/null && id xrdp >/dev/null 2>&1; then
		adduser --quiet xrdp ssl-cert >/dev/null 2>&1 || true
	fi
	# New accounts start in zsh (/etc/skel/.zshrc: suggestions from history,
	# Tab to take them). Existing accounts keep theirs.
	if [ -x /usr/bin/zsh ]; then
		if [ -f /etc/adduser.conf ]; then
			if grep -q '^#\?DSHELL=' /etc/adduser.conf; then
				sed -i 's|^#\?DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf
			else
				echo 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf
			fi
		fi
		if [ -f /etc/default/useradd ]; then
			if grep -q '^#\? *SHELL=' /etc/default/useradd; then
				sed -i 's|^#\? *SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd
			else
				echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd
			fi
		fi
	fi
	# Flathub for the App Centre (Discover), where it can be reached.
	if command -v flatpak >/dev/null 2>&1; then
		flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 || true
	fi
	# zram: compressed swap in memory, half of it, zstd (holds more than
	# lz4 on a 4 GB machine). Debian 13's file already has ALGO=lz4 and
	# PERCENT=50 set, so the stock lz4 line is changed, once (an
	# administrator who sets lz4 again keeps it); older files get both.
	if [ -f /etc/default/zramswap ] && [ ! -e /var/lib/cybroid/zram-zstd ]; then
		mkdir -p /var/lib/cybroid && : > /var/lib/cybroid/zram-zstd
		if grep -q '^ALGO=lz4$' /etc/default/zramswap; then
			sed -i 's/^ALGO=lz4$/ALGO=zstd/' /etc/default/zramswap
		elif ! grep -q '^PERCENT=' /etc/default/zramswap; then
			printf '\n# CybroidOS: half the memory as compressed swap.\nALGO=zstd\nPERCENT=50\n' >> /etc/default/zramswap
		fi
	fi
	# The firewall on the first start; systemd-oomd against out-of-memory
	# freezes (its limits: usr/lib/systemd/system/*.d/10-cybroid-oomd.conf).
	systemctl enable cybroid-firewall-setup.service systemd-oomd.service >/dev/null 2>&1 || true
	# Machines already set up get this version's new firewall rules (SSH over
	# Tower, KDE Connect), keeping their own. SSH starts at boot.
	/usr/libexec/cybroid/firewall-setup --add-rules >/dev/null 2>&1 || true
	systemctl enable ssh.service >/dev/null 2>&1 || true
	# Bluetooth says this computer's name, not "BlueZ 5.82".
	systemctl enable cybroid-bluetooth-name.service >/dev/null 2>&1 || true
	# SSDs stay fast: a weekly trim (util-linux's timer).
	systemctl enable fstrim.timer >/dev/null 2>&1 || true
	# Start graphical, on the CybroidOS sign-in screen.
	systemctl set-default graphical.target >/dev/null 2>&1 || true
	if [ -f /etc/X11/default-display-manager ]; then
		echo /usr/bin/sddm > /etc/X11/default-display-manager
	fi
	# A quiet boot behind the splash.
	if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then
		update-grub >/dev/null 2>&1 || true
	fi
fi
exit 0
